+bool ShaderProgramManager::LinkCurrentProgram(bool accurate_mul) {
+    if (impl->separable) {
+        return true;
+    }
+    const u64 unique_identifier = impl->current.GetConfigHash();
+    if (impl->failed_programs.contains(unique_identifier)) {
+        return false;
+    }
+    OGLProgram& cached_program = impl->program_cache[unique_identifier];
+    if (cached_program.handle == 0) {
+        cached_program.Create(false,
+                              std::array{impl->current.vs, impl->current.gs, impl->current.fs});
+        GLint linked = GL_FALSE;
+        glGetProgramiv(cached_program.handle, GL_LINK_STATUS, &linked);
+        if (linked != GL_TRUE) {
+            // Some drivers (e.g. Adreno) reject very large translated PICA vertex shaders.
+            // Don't cache the broken program; its draws fall back to CPU vertex processing.
+            LOG_WARNING(Render_OpenGL, "Program {:016x} failed to link; using CPU vertex shading",
+                        unique_identifier);
+            impl->program_cache.erase(unique_identifier);
+            impl->failed_programs.insert(unique_identifier);
+            return false;
         }
-        state.draw.shader_program = cached_program.handle;
+        auto& disk_cache = impl->disk_cache;
+        disk_cache.SaveDumpToFile(unique_identifier, cached_program.handle, accurate_mul);
     }
+    return true;
 }
 
