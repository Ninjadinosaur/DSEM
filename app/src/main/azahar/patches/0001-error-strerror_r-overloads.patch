+    // strerror_r returns int (XSI) or char* (GNU) depending on the C library, API level and
+    // feature macros; let overload resolution pick the right handling for whichever we got.
+    struct StrErrorResult {
+        static const char* Get(int ret, const char* buf) {
+            return ret == 0 ? buf : "(strerror_r failed to format error)";
+        }
+        static const char* Get(const char* ret, const char*) {
+            return ret;
+        }
+    };
+    return std::string(StrErrorResult::Get(strerror_r(e, err_str, sizeof(err_str)), err_str));
