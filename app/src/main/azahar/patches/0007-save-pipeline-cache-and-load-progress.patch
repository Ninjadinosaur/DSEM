+// PipelineCache writes the driver pipeline cache to disk only when it is destroyed, so a frontend
+// that is killed in the background loses everything built since launch. Its header feeds the
+// shader cache version hash (changing it would discard every game's shader list), so the private
+// cache handle is reached through the explicit-instantiation access rule instead.
+struct DriverPipelineCacheTag {
+    using Type = vk::UniquePipelineCache PipelineCache::*;
+    friend Type Get(DriverPipelineCacheTag);
+};
+template <typename Tag, typename Tag::Type Member>
+struct PrivateMember {
+    friend typename Tag::Type Get(Tag) {
+        return Member;
+    }
+};
+template struct PrivateMember<DriverPipelineCacheTag, &PipelineCache::driver_pipeline_cache>;
+
+// The disk shader cache only queues its pipelines on these workers (see LoadDefaultDiskResources).
+struct PipelineWorkersTag {
+    using Type = Common::ThreadWorker PipelineCache::*;
+    friend Type Get(PipelineWorkersTag);
+};
+template struct PrivateMember<PipelineWorkersTag, &PipelineCache::pipeline_workers>;
+
+// Same file name PipelineCache uses for this title and GPU.
+std::string DriverPipelineCachePath(const Instance& instance, u64 program_id) {
+    return fmt::format("{}vulkan{}pipeline{}{:016X}-{:X}{:X}.bin",
+                       FileUtil::GetUserPath(FileUtil::UserPath::ShaderDir), DIR_SEP, DIR_SEP,
+                       program_id, instance.GetVendorID(), instance.GetDeviceID());
+}
