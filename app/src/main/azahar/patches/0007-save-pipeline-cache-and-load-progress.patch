+// Shader cache build progress during game load, for the frontend's loading screen (it polls from
+// another thread). Phase: -1 none, 0 vertex shaders, 1 fragment shaders, 2 geometry shaders,
+// 3 pipelines queued, 4 pipelines compiled (the slow part without a driver pipeline cache).
+static std::atomic<int> disk_load_phase{-1};
+static std::atomic<unsigned> disk_load_done{0};
+static std::atomic<unsigned> disk_load_total{0};
+
+static void RecordDiskLoadProgress(VideoCore::LoadCallbackStage stage, std::size_t done,
+                                   std::size_t total, const std::string& name) {
+    if (stage != VideoCore::LoadCallbackStage::Build) {
+        return;
+    }
+    static constexpr std::array<std::string_view, 5> phases{
+        "Vertex Shader", "Fragment Shader", "Geometry Shader", "Pipeline", "Pipeline Compile"};
+    const auto it = std::find(phases.begin(), phases.end(), name);
+    if (it == phases.end()) {
+        return;
+    }
+    disk_load_done = static_cast<unsigned>(done);
+    disk_load_total = static_cast<unsigned>(total);
+    disk_load_phase = static_cast<int>(it - phases.begin());
+}
+
+extern "C" RETRO_API void ds13r_get_load_progress(int* phase, unsigned* done, unsigned* total) {
+    *phase = disk_load_phase;
+    *done = disk_load_done;
+    *total = disk_load_total;
+}
+
+// Saves shader/pipeline caches built since the last save. Call from the thread that runs
+// retro_run, between frames; returns true if anything was written.
+extern "C" RETRO_API bool ds13r_save_disk_resources() {
+    if (!emu_instance || !emu_instance->game_loaded) {
+        return false;
+    }
+    return Core::System::GetInstance().GPU().Renderer().Rasterizer()->SaveDiskResources();
+}
