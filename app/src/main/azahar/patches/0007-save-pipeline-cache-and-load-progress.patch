+    Common::ThreadWorker& workers = pipeline_cache.*Get(PipelineWorkersTag{});
+    const std::size_t scheduled_before = workers.WorkScheduled();
+    const std::size_t done_before = workers.WorkDone();
     pipeline_cache.LoadCache(stop_loading, callback);
 
+    // The disk cache queues its pipelines on worker threads and returns straight away. Without a
+    // driver pipeline cache compiling them takes minutes, and the first thing that waits for the
+    // workers (a state load restarting the system, or the first draws) stalls with no feedback.
+    // Wait here instead, reporting progress, while the frontend can show a loading screen.
+    for (;;) {
+        const std::size_t total = workers.WorkScheduled() - scheduled_before;
+        const std::size_t done = std::min(workers.WorkDone() - done_before, total);
+        if (callback) {
+            callback(VideoCore::LoadCallbackStage::Build, done, total, "Pipeline Compile");
+        }
+        if (done >= total || stop_loading) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    // What is on disk now; anything the driver cache grows beyond this is unsaved.
+    const std::string saved_path =
+        DriverPipelineCachePath(instance, pipeline_cache.GetProgramID());
+    saved_pipeline_cache_size = FileUtil::Exists(saved_path) ? FileUtil::GetSize(saved_path) : 0;
+
     if (callback) {
         callback(VideoCore::LoadCallbackStage::Complete, 0, 0, "");
     }
 }
 
+bool RasterizerVulkan::SaveDiskResources() {
+    const vk::UniquePipelineCache& cache = pipeline_cache.*Get(DriverPipelineCacheTag{});
+    if (!Settings::values.use_disk_shader_cache || !cache) {
+        return false;
+    }
+    const vk::Device device = instance.GetDevice();
+    std::size_t size = 0;
+    if (device.getPipelineCacheData(*cache, &size, nullptr) != vk::Result::eSuccess ||
+        size == saved_pipeline_cache_size) {
+        return false;
+    }
+    const std::vector<u8> data = device.getPipelineCacheData(*cache);
+
+    // Write beside the old file and swap it in, so a kill mid-write keeps the previous cache.
+    const std::string path = DriverPipelineCachePath(instance, pipeline_cache.GetProgramID());
+    const std::string temp = path + ".tmp";
+    {
+        FileUtil::IOFile file{temp, "wb"};
+        if (!file.IsOpen() || file.WriteBytes(data.data(), data.size()) != data.size()) {
+            LOG_ERROR(Render_Vulkan, "Error writing pipeline cache {}", temp);
+            return false;
+        }
+    }
+    if (!FileUtil::Rename(temp, path)) {
+        LOG_ERROR(Render_Vulkan, "Error replacing pipeline cache {}", path);
+        return false;
+    }
+    saved_pipeline_cache_size = data.size();
+    return true;
+}
