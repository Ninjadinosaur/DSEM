# Normalise line endings in the repository; keep shell scripts LF and Windows scripts CRLF
# so gradlew works on every platform.
* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
# Patches are applied with git apply to LF sources; keep them byte-exact.
*.patch eol=lf
